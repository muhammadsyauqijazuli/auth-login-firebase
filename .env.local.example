# Firebase Configuration
# Get these values from Firebase Console: Project Settings > General > Your apps > Web app

# Your Firebase project's unique identifier
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here

# Authentication domain for your Firebase project (format: your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase project ID (same as your project's URL identifier)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Cloud Storage bucket URL (format: your-project-id.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Cloud Messaging sender ID (for push notifications)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Unique app identifier for your Firebase application
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Firebase Analytics measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual Firebase config
# 3. Never commit .env.local to version control (already in .gitignore)
# 4. For production, set these in Vercel Environment Variables
